<Window
    x:Class="Wisp.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Wisp.Windows"
    xmlns:tb="using:H.NotifyIcon"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Wisp">

    <Grid x:Name="RootGrid"
          AllowDrop="True"
          DragOver="Root_DragOver"
          DragLeave="Root_DragLeave"
          Drop="Root_Drop"
          Background="{ThemeResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom title bar -->
        <Grid x:Name="TitleBarDragRegion" Grid.Row="0" Background="Transparent">
            <StackPanel Orientation="Horizontal" Spacing="10" Margin="18,0,0,0"
                        VerticalAlignment="Center">
                <Border Width="24" Height="24" CornerRadius="8"
                        Background="{StaticResource AuroraGradientBrush}">
                    <TextBlock Text="w" FontFamily="Segoe UI Variable Display"
                               FontWeight="Bold" FontSize="14"
                               Foreground="#08120F"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="wisp" FontFamily="Segoe UI Variable Display"
                           FontSize="15" FontWeight="SemiBold"
                           Foreground="{ThemeResource TextPrimaryBrush}"
                           VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="10"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Margin="0,0,150,0">
                <Button x:Name="HeaderActivityCluster"
                        Style="{StaticResource SecondaryActionButtonStyle}"
                        Padding="10,5" MinHeight="0" BorderThickness="0"
                        Click="HeaderActivity_Click"
                        AutomationProperties.Name="Active transfers">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ProgressRing x:Name="HeaderGauge" Width="16" Height="16"
                                      IsIndeterminate="False" IsActive="False"
                                      Value="0" Maximum="100"
                                      Visibility="Collapsed" />
                        <Ellipse x:Name="HeaderStatusDot" Width="7" Height="7"
                                 Fill="{ThemeResource TextTertiaryBrush}"
                                 Visibility="Visible" />
                        <TextBlock x:Name="HeaderStatusText" Text="starting…"
                                   FontSize="12"
                                   Foreground="{ThemeResource TextSecondaryBrush}" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <NavigationView x:Name="NavView"
                        Grid.Row="1"
                        Background="Transparent"
                        PaneDisplayMode="Left"
                        IsPaneOpen="True"
                        OpenPaneLength="236"
                        IsPaneToggleButtonVisible="False"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        SelectionChanged="NavView_SelectionChanged">
            <NavigationView.PaneHeader>
                <StackPanel Margin="10,4,0,18" Spacing="3">
                    <TextBlock Text="Send anything nearby"
                               FontFamily="Segoe UI Variable Display"
                               FontSize="15" FontWeight="SemiBold"
                               Foreground="{ThemeResource TextPrimaryBrush}" />
                    <TextBlock Text="Private by design"
                               FontSize="12"
                               Foreground="{ThemeResource TextTertiaryBrush}" />
                </StackPanel>
            </NavigationView.PaneHeader>

            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="NearbyNavItem" Content="Nearby" Tag="nearby" IsSelected="True">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE716;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="TransfersNavItem" Content="Transfers" Tag="transfers">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE896;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Devices" Tag="devices">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE772;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Settings" Tag="settings">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE713;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.PaneFooter>
                <Border Margin="8,0,8,10" Padding="12" CornerRadius="16"
                        Background="{ThemeResource CardBrush}"
                        BorderBrush="{ThemeResource CardStrokeBrush}" BorderThickness="1">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Border Width="36" Height="36" CornerRadius="12"
                                Background="{StaticResource AuroraGradientBrush}">
                            <TextBlock x:Name="SelfFooterInitials" Text="W"
                                       FontWeight="SemiBold" FontSize="12"
                                       Foreground="#08120F"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center" MaxWidth="140">
                            <TextBlock x:Name="SelfFooterName" Text="This device"
                                       FontSize="13" FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextPrimaryBrush}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="SelfFooterStatus" Text="Starting…"
                                       FontSize="11"
                                       Foreground="{ThemeResource TextTertiaryBrush}"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </NavigationView.PaneFooter>

            <!-- CONTENT -->
            <Grid>
                <!-- NEARBY -->
                <Grid x:Name="NearbyView" Margin="32,22,32,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Margin="0,0,0,20">
                        <StackPanel Spacing="6">
                            <TextBlock Text="Nearby" Style="{StaticResource DisplayTextStyle}" />
                            <TextBlock Text="The devices around you, ready for whatever you want to move."
                                       Style="{StaticResource SecondaryTextStyle}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="10"
                                    HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Style="{StaticResource SecondaryActionButtonStyle}"
                                    Click="SendFolder_Click"
                                    AutomationProperties.Name="Send a folder">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8B7;" FontSize="14" />
                                    <TextBlock Text="Folder" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource PrimaryActionButtonStyle}"
                                    Click="SendFiles_Click"
                                    AutomationProperties.Name="Send files">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE724;" FontSize="14" Foreground="{ThemeResource OnAccentBrush}" />
                                    <TextBlock Text="Send files" Foreground="{ThemeResource OnAccentBrush}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                  Padding="0,0,8,28">
                        <StackPanel Spacing="20">
                            <!-- Presence -->
                            <Border CornerRadius="24" BorderThickness="1"
                                    BorderBrush="{ThemeResource CardStrokeBrush}"
                                    Background="{StaticResource PresenceGradientBrush}"
                                    Height="188">
                                <Grid>
                                    <Ellipse Width="420" Height="420" Opacity=".18"
                                             Fill="{StaticResource AuroraGradientBrush}"
                                             HorizontalAlignment="Right" VerticalAlignment="Center"
                                             Margin="0,0,-70,0" />
                                    <Ellipse Width="180" Height="180" Opacity=".09"
                                             Stroke="{ThemeResource MintBrush}" StrokeThickness="1"
                                             HorizontalAlignment="Right" VerticalAlignment="Center"
                                             Margin="0,0,40,0" />
                                    <Grid Margin="28,0" VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid Width="104" Height="104">
                                            <Ellipse x:Name="PresencePulse"
                                                     Width="104" Height="104"
                                                     Stroke="{ThemeResource MintBrush}"
                                                     StrokeThickness="1.5" Opacity=".55" />
                                            <Border Width="72" Height="72" CornerRadius="24"
                                                    Background="{StaticResource AuroraGradientBrush}"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock x:Name="SelfInitialsText" Text="W"
                                                           FontSize="22" FontWeight="Bold"
                                                           Foreground="#08120F"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                            </Border>
                                        </Grid>
                                        <StackPanel Grid.Column="1" Spacing="5" Margin="12,0,0,0"
                                                    VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Spacing="7">
                                                <Ellipse x:Name="PresenceDot" Width="7" Height="7"
                                                         Fill="{ThemeResource TextTertiaryBrush}" />
                                                <TextBlock x:Name="PresenceStatusText" Text="Connecting…"
                                                           FontSize="12" FontWeight="SemiBold"
                                                           Foreground="{ThemeResource MintBrush}" />
                                            </StackPanel>
                                            <TextBlock x:Name="SelfNameText" Text="This device"
                                                       FontFamily="Segoe UI Variable Display"
                                                       FontSize="26" FontWeight="SemiBold"
                                                       Foreground="{ThemeResource TextPrimaryBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock x:Name="SelfSubtitleText"
                                                       Text="Visible to nearby devices on this Wi-Fi."
                                                       Style="{StaticResource SecondaryTextStyle}" />
                                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                                                <Button Style="{StaticResource SecondaryActionButtonStyle}"
                                                        Click="ShowIdentity_Click"
                                                        AutomationProperties.Name="Show this device identity">
                                                    <TextBlock Text="Show identity" />
                                                </Button>
                                                <Button Style="{StaticResource IconButtonStyle}"
                                                        Click="Refresh_Click"
                                                        ToolTipService.ToolTip="Refresh nearby devices"
                                                        AutomationProperties.Name="Refresh nearby devices">
                                                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE72C;" FontSize="14" />
                                                </Button>
                                            </StackPanel>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Top"
                                                    HorizontalAlignment="Right" Spacing="3">
                                            <TextBlock Text="WISP" FontSize="10" FontWeight="Bold"
                                                       CharacterSpacing="180"
                                                       Foreground="{ThemeResource TextTertiaryBrush}"
                                                       HorizontalAlignment="Right" />
                                            <TextBlock Text="direct · encrypted" FontSize="11"
                                                       Foreground="{ThemeResource TextSecondaryBrush}"
                                                       HorizontalAlignment="Right" />
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Border>

                            <Grid Margin="0,4,0,0">
                                <TextBlock Text="Nearby devices" Style="{StaticResource SectionTextStyle}" />
                                <TextBlock x:Name="PeerCountText" Text="Looking around…"
                                           HorizontalAlignment="Right" VerticalAlignment="Center"
                                           Style="{StaticResource CaptionTextStyle}" />
                            </Grid>

                            <ItemsRepeater x:Name="PeerRepeater">
                                <ItemsRepeater.Layout>
                                    <UniformGridLayout MinItemWidth="248"
                                                       MinItemHeight="176"
                                                       MinColumnSpacing="16"
                                                       MinRowSpacing="16"
                                                       ItemsStretch="Fill" />
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="local:PeerItem">
                                        <Button Style="{StaticResource PeerCardStyle}"
                                                Tag="{x:Bind Id}"
                                                Click="PeerCard_Click"
                                                AllowDrop="True"
                                                DragOver="PeerCard_DragOver"
                                                Drop="PeerCard_Drop"
                                                AutomationProperties.Name="{x:Bind Name}">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="*" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Grid>
                                                    <Border Width="54" Height="54" CornerRadius="18"
                                                            Background="{x:Bind AvatarBrush}"
                                                            HorizontalAlignment="Left">
                                                        <TextBlock Text="{x:Bind Initials}"
                                                                   FontSize="16" FontWeight="Bold"
                                                                   Foreground="#08120F"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center" />
                                                    </Border>
                                                    <Border Width="30" Height="30" CornerRadius="10"
                                                            Background="{ThemeResource MintSoftBrush}"
                                                            HorizontalAlignment="Right"
                                                            VerticalAlignment="Top">
                                                        <FontIcon Glyph="{x:Bind PlatformGlyph}"
                                                                  FontFamily="Segoe Fluent Icons"
                                                                  FontSize="13"
                                                                  Foreground="{ThemeResource MintBrush}" />
                                                    </Border>
                                                </Grid>
                                                <StackPanel Grid.Row="1" VerticalAlignment="Bottom"
                                                            Margin="0,16,0,0" Spacing="3">
                                                    <TextBlock Text="{x:Bind Name}"
                                                               FontSize="16" FontWeight="SemiBold"
                                                               Foreground="{ThemeResource TextPrimaryBrush}"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{x:Bind Subtitle}"
                                                               Style="{StaticResource CaptionTextStyle}" />
                                                </StackPanel>
                                                <StackPanel Grid.Row="2" Orientation="Horizontal"
                                                            Spacing="7" Margin="0,12,0,0">
                                                    <Ellipse Width="6" Height="6"
                                                             Fill="{ThemeResource MintBrush}"
                                                             VerticalAlignment="Center" />
                                                    <TextBlock Text="Tap to send"
                                                               FontSize="12"
                                                               Foreground="{ThemeResource TextSecondaryBrush}" />
                                                </StackPanel>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>

                            <Border x:Name="NoPeersCard" Style="{StaticResource CardStyle}"
                                    Visibility="Collapsed">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="52" Height="52" CornerRadius="16"
                                            Background="{ThemeResource MintSoftBrush}">
                                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE716;"
                                                  FontSize="20" Foreground="{ThemeResource MintBrush}" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="16,0" Spacing="3"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="No devices visible yet"
                                                   Style="{StaticResource SectionTextStyle}" />
                                        <TextBlock Text="Keep Wisp open on the other device and make sure both are on the same Wi-Fi."
                                                   Style="{StaticResource SecondaryTextStyle}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal"
                                                Spacing="8" VerticalAlignment="Center">
                                        <Button Content="Show identity"
                                                Style="{StaticResource SecondaryActionButtonStyle}"
                                                Click="ShowIdentity_Click" />
                                        <Button Content="Connect by address"
                                                Style="{StaticResource SecondaryActionButtonStyle}"
                                                Click="AddManualPeer_Click" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border x:Name="DropZone" Style="{StaticResource CardStyle}"
                                    Background="Transparent" Padding="26"
                                    MinHeight="132">
                                <Grid>
                                    <Rectangle Stroke="{ThemeResource LineBrush}"
                                               StrokeThickness="1.4" StrokeDashArray="5,4"
                                               RadiusX="18" RadiusY="18" />
                                    <Grid Margin="18,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="46" Height="46" CornerRadius="15"
                                                Background="{ThemeResource CardStrongBrush}">
                                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE898;"
                                                      FontSize="18"
                                                      Foreground="{ThemeResource TextSecondaryBrush}" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="14,0" Spacing="2"
                                                    VerticalAlignment="Center">
                                            <TextBlock Text="Drop files or folders here"
                                                       FontSize="15" FontWeight="SemiBold"
                                                       Foreground="{ThemeResource TextPrimaryBrush}" />
                                            <TextBlock Text="They go straight to the device you pick. Nothing is uploaded."
                                                       Style="{StaticResource CaptionTextStyle}" />
                                        </StackPanel>
                                        <Button Grid.Column="2" Content="Choose files"
                                                Style="{StaticResource SecondaryActionButtonStyle}"
                                                Click="SendFiles_Click"
                                                VerticalAlignment="Center" />
                                    </Grid>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- TRANSFERS -->
                <Grid x:Name="TransfersView" Margin="32,22,32,0" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,0,18">
                        <StackPanel Spacing="6">
                            <TextBlock Text="Transfers" Style="{StaticResource DisplayTextStyle}" />
                            <TextBlock Text="Everything moving, and everything that landed."
                                       Style="{StaticResource SecondaryTextStyle}" />
                        </StackPanel>
                        <Button Content="Clear finished"
                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                Style="{StaticResource SecondaryActionButtonStyle}"
                                Click="ClearFinished_Click" />
                    </Grid>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,8,28">
                        <StackPanel Spacing="10">
                            <ItemsRepeater x:Name="TransferRepeater">
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="local:TransferItem">
                                        <Border Style="{StaticResource CardStyle}"
                                                Padding="18" Margin="0,0,0,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border Width="46" Height="46" CornerRadius="15"
                                                        Background="{ThemeResource CardStrongBrush}"
                                                        VerticalAlignment="Top">
                                                    <FontIcon Glyph="{x:Bind DirectionGlyph}"
                                                              FontFamily="Segoe Fluent Icons"
                                                              FontSize="17"
                                                              Foreground="{ThemeResource BlueBrush}" />
                                                </Border>
                                                <StackPanel Grid.Column="1" Margin="14,0" Spacing="6">
                                                    <Grid>
                                                        <TextBlock Text="{x:Bind Title}"
                                                                   FontSize="15" FontWeight="SemiBold"
                                                                   Foreground="{ThemeResource TextPrimaryBrush}" />
                                                        <StackPanel Orientation="Horizontal" Spacing="8"
                                                                    HorizontalAlignment="Right"
                                                                    VerticalAlignment="Center">
                                                            <Ellipse Width="6" Height="6"
                                                                     Fill="{x:Bind StateBrush, Mode=OneWay}"
                                                                     VerticalAlignment="Center" />
                                                            <TextBlock Text="{x:Bind Status, Mode=OneWay}"
                                                                       FontSize="12"
                                                                       Foreground="{ThemeResource TextSecondaryBrush}" />
                                                        </StackPanel>
                                                    </Grid>
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <TextBlock Text="{x:Bind DirectionLabel}"
                                                                   FontSize="10" FontWeight="Bold"
                                                                   CharacterSpacing="120"
                                                                   Foreground="{ThemeResource TextTertiaryBrush}" />
                                                        <TextBlock Text="{x:Bind SizeText, Mode=OneWay}"
                                                                   Style="{StaticResource CaptionTextStyle}" />
                                                    </StackPanel>
                                                    <ProgressBar Value="{x:Bind Percent, Mode=OneWay}"
                                                                 Maximum="100"
                                                                 Visibility="{x:Bind ProgressVisibility, Mode=OneWay}"
                                                                 Margin="0,3,0,0" />
                                                    <StackPanel Orientation="Horizontal" Spacing="12"
                                                                Visibility="{x:Bind ProgressVisibility, Mode=OneWay}">
                                                        <TextBlock Text="{x:Bind SpeedText, Mode=OneWay}"
                                                                   FontSize="12"
                                                                   Foreground="{ThemeResource MintBrush}" />
                                                        <TextBlock Text="{x:Bind RemainingText, Mode=OneWay}"
                                                                   Style="{StaticResource CaptionTextStyle}" />
                                                    </StackPanel>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Spacing="8"
                                                            VerticalAlignment="Center">
                                                    <Button Content="Cancel"
                                                            Tag="{x:Bind TransferId}"
                                                            Click="CancelTransfer_Click"
                                                            Visibility="{x:Bind CancelVisibility, Mode=OneWay}"
                                                            Style="{StaticResource SecondaryActionButtonStyle}" />
                                                    <Button Content="Open folder"
                                                            Tag="{x:Bind SavedPath}"
                                                            Click="OpenCompletedFolder_Click"
                                                            Visibility="{x:Bind OpenFolderVisibility, Mode=OneWay}"
                                                            Style="{StaticResource SecondaryActionButtonStyle}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                            <Border x:Name="NoTransfersCard" Style="{StaticResource CardStyle}"
                                    Padding="30" Visibility="Collapsed">
                                <StackPanel Spacing="8" HorizontalAlignment="Center">
                                    <Border Width="56" Height="56" CornerRadius="18"
                                            Background="{ThemeResource MintSoftBrush}"
                                            HorizontalAlignment="Center">
                                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE896;"
                                                  FontSize="20"
                                                  Foreground="{ThemeResource MintBrush}" />
                                    </Border>
                                    <TextBlock Text="Nothing in motion"
                                               Style="{StaticResource SectionTextStyle}"
                                               HorizontalAlignment="Center" />
                                    <TextBlock Text="Send something nearby and it will show up here."
                                               Style="{StaticResource SecondaryTextStyle}"
                                               HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- DEVICES -->
                <Grid x:Name="DevicesView" Margin="32,22,32,0" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,0,18">
                        <StackPanel Spacing="6">
                            <TextBlock Text="Devices" Style="{StaticResource DisplayTextStyle}" />
                            <TextBlock Text="Identity, trust, and the devices you have let in."
                                       Style="{StaticResource SecondaryTextStyle}" />
                        </StackPanel>
                        <Button Content="Add by address"
                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                Style="{StaticResource SecondaryActionButtonStyle}"
                                Click="AddManualPeer_Click" />
                    </Grid>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,8,28">
                        <StackPanel Spacing="20">
                            <Border Style="{StaticResource CardStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="56" Height="56" CornerRadius="18"
                                            Background="{StaticResource AuroraGradientBrush}">
                                        <TextBlock x:Name="IdentityInitials" Text="W"
                                                   FontWeight="Bold" FontSize="17"
                                                   Foreground="#08120F"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="16,0" Spacing="3">
                                        <TextBlock Text="This device"
                                                   Style="{StaticResource CaptionTextStyle}" />
                                        <TextBlock x:Name="IdentityNameText" Text="This PC"
                                                   Style="{StaticResource TitleTextStyle}" />
                                        <TextBlock Text="Your identity is a local key pair. It never leaves this PC."
                                                   Style="{StaticResource SecondaryTextStyle}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Spacing="8"
                                                VerticalAlignment="Center">
                                        <Button Content="Copy peer ID"
                                                Click="CopyPeerId_Click"
                                                Style="{StaticResource SecondaryActionButtonStyle}" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource CardStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="IDENTITY" Style="{StaticResource CaptionTextStyle}" />
                                        <TextBlock Text="Peer ID" FontSize="11" Margin="0,10,0,2"
                                                   Foreground="{ThemeResource TextTertiaryBrush}" />
                                        <TextBlock x:Name="IdentityPeerIdText" Text="—"
                                                   FontFamily="Consolas" FontSize="12"
                                                   IsTextSelectionEnabled="True"
                                                   Foreground="{ThemeResource TextPrimaryBrush}" />
                                        <TextBlock Text="Public key fingerprint" FontSize="11" Margin="0,12,0,2"
                                                   Foreground="{ThemeResource TextTertiaryBrush}" />
                                        <TextBlock x:Name="IdentityFingerprintText" Text="—"
                                                   FontFamily="Consolas" FontSize="11"
                                                   IsTextSelectionEnabled="True" TextWrapping="Wrap"
                                                   Foreground="{ThemeResource TextSecondaryBrush}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="40,0,0,0" Spacing="6">
                                        <TextBlock Text="How pairing works"
                                                   Style="{StaticResource SectionTextStyle}" />
                                        <TextBlock Text="On a first transfer, both screens show a six-digit code. Compare them before accepting. Wisp pins the device key after you trust it."
                                                   Style="{StaticResource SecondaryTextStyle}" />
                                        <TextBlock Text="You can also verify the fingerprint above with the other device."
                                                   Style="{StaticResource CaptionTextStyle}" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Grid>
                                <TextBlock Text="Trusted devices" Style="{StaticResource SectionTextStyle}" />
                                <TextBlock x:Name="TrustedCountText" Text=""
                                           HorizontalAlignment="Right" VerticalAlignment="Center"
                                           Style="{StaticResource CaptionTextStyle}" />
                            </Grid>
                            <ItemsRepeater x:Name="TrustedRepeater">
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="local:TrustedDeviceItem">
                                        <Border Style="{StaticResource CardStyle}"
                                                Padding="16" Margin="0,0,0,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border Width="42" Height="42" CornerRadius="14"
                                                        Background="{x:Bind AvatarBrush}">
                                                    <TextBlock Text="{x:Bind Initials}"
                                                               FontSize="13" FontWeight="Bold"
                                                               Foreground="#08120F"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center" />
                                                </Border>
                                                <StackPanel Grid.Column="1" Margin="14,0" Spacing="2"
                                                            VerticalAlignment="Center">
                                                    <TextBlock Text="{x:Bind Name}"
                                                               FontSize="14" FontWeight="SemiBold"
                                                               Foreground="{ThemeResource TextPrimaryBrush}" />
                                                    <TextBlock Text="{x:Bind FingerprintShort}"
                                                               FontFamily="Consolas" FontSize="11"
                                                               Foreground="{ThemeResource TextTertiaryBrush}" />
                                                </StackPanel>
                                                <CheckBox Grid.Column="2" Content="Auto-accept"
                                                          Tag="{x:Bind Fingerprint}"
                                                          IsChecked="{x:Bind AutoAccept}"
                                                          Checked="TrustedAutoAccept_Changed"
                                                          Unchecked="TrustedAutoAccept_Changed"
                                                          VerticalAlignment="Center" />
                                                <Button Grid.Column="3" Style="{StaticResource IconButtonStyle}"
                                                        Tag="{x:Bind Fingerprint}"
                                                        Click="RemoveTrusted_Click"
                                                        ToolTipService.ToolTip="Forget this device"
                                                        AutomationProperties.Name="Remove trusted device">
                                                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE74D;" FontSize="14" />
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                            <Border x:Name="NoTrustedCard" Style="{StaticResource CardStyle}"
                                    Padding="28" Visibility="Collapsed">
                                <StackPanel Spacing="6" HorizontalAlignment="Center">
                                    <TextBlock Text="No trusted devices yet"
                                               Style="{StaticResource SectionTextStyle}"
                                               HorizontalAlignment="Center" />
                                    <TextBlock Text="After accepting a transfer, choose “Trust this device” to pin it."
                                               Style="{StaticResource SecondaryTextStyle}"
                                               HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource CardStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="No shared Wi-Fi?"
                                                   Style="{StaticResource SectionTextStyle}" />
                                        <TextBlock Text="Use Connect by address if discovery is blocked. On the other device, open Devices and read its peer ID, port, and fingerprint."
                                                   Style="{StaticResource SecondaryTextStyle}" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Connect by address"
                                            Style="{StaticResource SecondaryActionButtonStyle}"
                                            Click="AddManualPeer_Click"
                                            VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- SETTINGS -->
                <Grid x:Name="SettingsView" Margin="32,22,32,0" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Margin="0,0,0,18" Spacing="6">
                        <TextBlock Text="Settings" Style="{StaticResource DisplayTextStyle}" />
                        <TextBlock Text="Make Wisp feel like yours."
                                   Style="{StaticResource SecondaryTextStyle}" />
                    </StackPanel>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,8,28">
                        <StackPanel Spacing="20" MaxWidth="780" HorizontalAlignment="Left">
                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel Spacing="16">
                                    <TextBlock Text="This device" Style="{StaticResource SectionTextStyle}" />
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="Device name" Style="{StaticResource CaptionTextStyle}" />
                                        <TextBox x:Name="DeviceNameBox" PlaceholderText="e.g. Studio PC"
                                                 MaxLength="64" />
                                    </StackPanel>
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="Save received files to" Style="{StaticResource CaptionTextStyle}" />
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="SaveDirectoryBox" />
                                            <Button Grid.Column="1" Content="Browse"
                                                    Style="{StaticResource SecondaryActionButtonStyle}"
                                                    Click="BrowseSaveDirectory_Click" />
                                        </Grid>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Content="Save &amp; restart engine"
                                                Style="{StaticResource PrimaryActionButtonStyle}"
                                                Click="ApplySettings_Click" />
                                        <TextBlock x:Name="SettingsStatusText" VerticalAlignment="Center"
                                                   Style="{StaticResource CaptionTextStyle}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="Trust &amp; receiving" Style="{StaticResource SectionTextStyle}" />
                                    <ToggleSwitch x:Name="AutoAcceptTrustedToggle"
                                                  Header="Auto-accept transfers from trusted devices"
                                                  OnContent="On" OffContent="Ask first" />
                                    <TextBlock Text="New devices always ask. You can still decline a trusted device at any time."
                                               Style="{StaticResource CaptionTextStyle}" />
                                    <ToggleSwitch x:Name="SoundsToggle"
                                                  Header="Sounds"
                                                  OnContent="On" OffContent="Off" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="Network" Style="{StaticResource SectionTextStyle}" />
                                    <TextBlock Text="Wisp listens only on your local network. If Windows Firewall blocks it, add an inbound allow rule for Wisp on Private networks."
                                               Style="{StaticResource SecondaryTextStyle}" />
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <Button Content="Open firewall settings"
                                                Style="{StaticResource SecondaryActionButtonStyle}"
                                                Click="OpenFirewallSettings_Click" />
                                        <Button Content="Refresh nearby"
                                                Style="{StaticResource SecondaryActionButtonStyle}"
                                                Click="Refresh_Click" />
                                    </StackPanel>
                                    <TextBlock x:Name="NetworkDetailText" Text=""
                                               Style="{StaticResource CaptionTextStyle}" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel Spacing="7">
                                    <TextBlock Text="About Wisp" Style="{StaticResource SectionTextStyle}" />
                                    <TextBlock x:Name="AboutText" Text="Wisp"
                                               Style="{StaticResource SecondaryTextStyle}" />
                                    <TextBlock Text="Local-first file transfer. No account, no cloud relay, no analytics. Files are protected with TLS 1.3 and verified chunk-by-chunk."
                                               Style="{StaticResource CaptionTextStyle}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </NavigationView>

        <!-- Drop affordance (does not block hit testing) -->
        <Grid x:Name="DropOverlay" Grid.Row="1" Visibility="Collapsed"
              IsHitTestVisible="False" Margin="24">
            <Border VerticalAlignment="Top" HorizontalAlignment="Center"
                    Background="{ThemeResource CardStrongBrush}"
                    BorderBrush="{ThemeResource MintBrush}" BorderThickness="1"
                    CornerRadius="16" Padding="18,12"
>
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE896;"
                              Foreground="{ThemeResource MintBrush}" FontSize="18" />
                    <TextBlock Text="Drop on a nearby device — or anywhere to choose one"
                               Foreground="{ThemeResource TextPrimaryBrush}" FontWeight="SemiBold" />
                </StackPanel>
            </Border>
        </Grid>

        <InfoBar x:Name="ToastBar"
                 Grid.Row="1"
                 IsOpen="False"
                 IsClosable="True"
                 Severity="Informational"
                 HorizontalAlignment="Right"
                 VerticalAlignment="Bottom"
                 Width="460"
                 Margin="0,0,24,24" />
        <tb:TaskbarIcon x:Name="TrayIcon"
                        Grid.Row="1"
                        ToolTipText="Wisp — direct file transfer"
                        Visibility="Collapsed">
            <tb:TaskbarIcon.ContextFlyout>
                <MenuFlyout>
                    <MenuFlyoutItem Text="Open Wisp" Click="TrayIcon_Clicked" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Text="Quit" Click="TrayQuit_Click" />
                </MenuFlyout>
            </tb:TaskbarIcon.ContextFlyout>
        </tb:TaskbarIcon>
    </Grid>
</Window>
