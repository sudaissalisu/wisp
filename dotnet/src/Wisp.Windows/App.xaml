<Application
    x:Class="Wisp.Windows.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#0B0E12" />
                    <SolidColorBrush x:Key="SidebarBrush" Color="#D90E1218" />
                    <SolidColorBrush x:Key="CardBrush" Color="#E6151A21" />
                    <SolidColorBrush x:Key="CardStrongBrush" Color="#F21A2029" />
                    <SolidColorBrush x:Key="CardStrokeBrush" Color="#1FFFFFFF" />
                    <SolidColorBrush x:Key="HoverBrush" Color="#14FFFFFF" />
                    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F5F8F7" />
                    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#9AA6A3" />
                    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#66726F" />
                    <SolidColorBrush x:Key="MintBrush" Color="#45E3B4" />
                    <SolidColorBrush x:Key="MintSoftBrush" Color="#2445E3B4" />
                    <SolidColorBrush x:Key="BlueBrush" Color="#5B8DEF" />
                    <SolidColorBrush x:Key="CoralBrush" Color="#FF7168" />
                    <SolidColorBrush x:Key="CoralSoftBrush" Color="#26FF7168" />
                    <SolidColorBrush x:Key="LineBrush" Color="#1FFFFFFF" />
                    <SolidColorBrush x:Key="DangerBrush" Color="#FF8A80" />
                    <SolidColorBrush x:Key="OnAccentBrush" Color="#08120F" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F5F7F6" />
                    <SolidColorBrush x:Key="SidebarBrush" Color="#EFFFFFFF" />
                    <SolidColorBrush x:Key="CardBrush" Color="#F7FFFFFF" />
                    <SolidColorBrush x:Key="CardStrongBrush" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="CardStrokeBrush" Color="#140B0E12" />
                    <SolidColorBrush x:Key="HoverBrush" Color="#0A0B0E12" />
                    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#111619" />
                    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#65716D" />
                    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#89938F" />
                    <SolidColorBrush x:Key="MintBrush" Color="#14C99A" />
                    <SolidColorBrush x:Key="MintSoftBrush" Color="#2414C99A" />
                    <SolidColorBrush x:Key="BlueBrush" Color="#356FD4" />
                    <SolidColorBrush x:Key="CoralBrush" Color="#E95C50" />
                    <SolidColorBrush x:Key="CoralSoftBrush" Color="#20E95C50" />
                    <SolidColorBrush x:Key="LineBrush" Color="#120B0E12" />
                    <SolidColorBrush x:Key="DangerBrush" Color="#C93D32" />
                    <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <LinearGradientBrush x:Key="AuroraGradientBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Offset="0" Color="#5B8DEF" />
                <GradientStop Offset="0.55" Color="#45E3B4" />
                <GradientStop Offset="1" Color="#B7FFE8" />
            </LinearGradientBrush>

            <LinearGradientBrush x:Key="PresenceGradientBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Offset="0" Color="#283F7F" />
                <GradientStop Offset="0.5" Color="#143B33" />
                <GradientStop Offset="1" Color="#1A2029" />
            </LinearGradientBrush>

            <Style x:Key="DisplayTextStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Segoe UI Variable Display" />
                <Setter Property="FontSize" Value="34" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="TitleTextStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Segoe UI Variable Display" />
                <Setter Property="FontSize" Value="22" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="SectionTextStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Segoe UI Variable Display" />
                <Setter Property="FontSize" Value="17" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
            </Style>
            <Style x:Key="BodyTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="SecondaryTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Foreground" Value="{ThemeResource TextSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="CaptionTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{ThemeResource TextSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <Style x:Key="CardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="24" />
                <Setter Property="Padding" Value="22" />
            </Style>

            <Style x:Key="PeerCardStyle" TargetType="Button">
                <Setter Property="Background" Value="{ThemeResource CardBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="24" />
                <Setter Property="Padding" Value="20" />
                <Setter Property="MinHeight" Value="176" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Stretch" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="{TemplateBinding CornerRadius}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}">
                                <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5">
                                    <VisualStateManager.VisualStateGroups>
                                        <VisualStateGroup x:Name="CommonStates">
                                            <VisualState x:Name="Normal" />
                                            <VisualState x:Name="PointerOver">
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="HoverLayer"
                                                                     Storyboard.TargetProperty="Opacity"
                                                                     To="1" Duration="0:0:0.12" />
                                                </Storyboard>
                                            </VisualState>
                                            <VisualState x:Name="Pressed">
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="Root"
                                                                     Storyboard.TargetProperty="Opacity"
                                                                     To="0.82" Duration="0:0:0.08" />
                                                </Storyboard>
                                            </VisualState>
                                            <VisualState x:Name="Disabled">
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="Root"
                                                                     Storyboard.TargetProperty="Opacity"
                                                                     To="0.45" Duration="0:0:0.12" />
                                                </Storyboard>
                                            </VisualState>
                                        </VisualStateGroup>
                                    </VisualStateManager.VisualStateGroups>
                                    <Border x:Name="HoverLayer"
                                            Background="{ThemeResource HoverBrush}"
                                            Opacity="0"
                                            CornerRadius="{TemplateBinding CornerRadius}" />
                                    <ContentPresenter Content="{TemplateBinding Content}"
                                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                                      Margin="{TemplateBinding Padding}"
                                                      HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                      VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                                </Grid>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="PrimaryActionButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{ThemeResource MintBrush}" />
                <Setter Property="Foreground" Value="{ThemeResource OnAccentBrush}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="Padding" Value="18,10" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="MinHeight" Value="40" />
            </Style>

            <Style x:Key="SecondaryActionButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{ThemeResource CardStrongBrush}" />
                <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="Padding" Value="16,9" />
                <Setter Property="MinHeight" Value="40" />
            </Style>

            <Style x:Key="IconButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{ThemeResource TextSecondaryBrush}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Padding" Value="10" />
                <Setter Property="MinWidth" Value="36" />
                <Setter Property="MinHeight" Value="36" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
